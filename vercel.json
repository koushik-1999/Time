{
  "version": 2,
  "builds": [
    {
      "src": "api/current-utc.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.html"
    },
    {
      "src": "/api/current-utc.js",
      "dest": "/api/current-utc.js"
    }
  ]
}
